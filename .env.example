# ==============================================================================
# VAYENTRA GURUKULA - ENVIRONMENT CONFIGURATION & TELECOM CREDENTIALS
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=5001
JWT_SECRET=vayentra-gurukula-production-secret-key-2026

# ==============================================================================
# UPSTREAM TELECOM PROVIDER CREDENTIALS: WHATSAPP CLOUD API (META)
# ==============================================================================
# Obtain from Meta for Developers > WhatsApp > API Setup:
# https://developers.facebook.com/apps/
WHATSAPP_API_KEY=
WHATSAPP_PHONE_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_URL=https://graph.facebook.com/v21.0

# ==============================================================================
# UPSTREAM TELECOM PROVIDER CREDENTIALS: SMS GATEWAY (TRAI / DLT COMPLIANT)
# ==============================================================================
# Provider selection: 'msg91' | 'twilio' | 'generic_http'
SMS_PROVIDER=msg91

# MSG91 Credentials (India Primary)
# DLT Header/Sender ID registered on Jio/Airtel/Vil DLT portal (6 alpha characters)
MSG_GATEWAY_API_KEY=
SMS_PROVIDER_KEY=
SMS_SENDER_ID=VAYENT
SMS_DLT_PE_ID=1701159123456789012
SMS_DLT_TEMPLATE_ID=1407161234567890123
SMS_GATEWAY_URL=https://control.msg91.com/api/v5/flow/

# Twilio Credentials (International / Fallback SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ==============================================================================
# STAGING & CI MOCK SWITCH
# ==============================================================================
# When false (default), real upstream HTTP requests are dispatched to telecom APIs.
# When true, verifies payload formatting and simulates gateway loopback with authentic IDs.
TELECOM_GATEWAY_MOCK=false
