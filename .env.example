# ==============================================================================
# VAYENTRA GURUKULA - ENVIRONMENT CONFIGURATION & TELECOM CREDENTIALS
# ==============================================================================

# Server Environment
NODE_ENV=production
PORT=5001
VITE_API_BASE_URL=https://gurukula.vayentra.org

# Database Configuration (SQLite WAL Mode)
DB_PATH=/var/data/vayentra/vayentra.sqlite

# Security & Authentication (DPDP Act 2023 Compliant)
# Ensure JWT_SECRET is at least 32 characters, randomly generated with openssl rand -base64 32
JWT_SECRET=replace_with_high_entropy_secret_64_bytes_minimum
SESSION_TIMEOUT_SECONDS=86400
ALLOWED_ORIGINS=https://gurukula.vayentra.org,http://localhost:3000

# ==============================================================================
# RAZORPAY PAYMENT GATEWAY (Digital Learning ₹599 Subscription)
# ==============================================================================
# In production, set live keys (rzp_live_...). In testing/staging, set test keys (rzp_test_...)
RAZORPAY_KEY_ID=rzp_test_replace_with_key_id
RAZORPAY_KEY_SECRET=replace_with_key_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_webhook_secret

# GST & Billing Requirements (DPDP & Indian Tax Compliance)
# TAX_CONFIG_APPROVED must be set to 'true' ONLY after chartered accountant verification
# of official GSTIN registration, legal entity name, and applicable SAC rate.
# If 'false', official GST tax invoices are blocked and provisional fee receipts are issued.
TAX_CONFIG_APPROVED=false
BUSINESS_LEGAL_NAME=Vayentra EdTech Private Limited
BUSINESS_GSTIN=
BUSINESS_SAC_CODE=9992
BUSINESS_BILLING_ADDRESS=Bengaluru, Karnataka, India
BUSINESS_STATE_CODE=29 (Karnataka)
GST_RATE_PERCENT=18
VAYENTRA_ANNUAL_PRICE_INR=599.00

# ==============================================================================
# UPSTREAM TELECOM PROVIDER CREDENTIALS: WHATSAPP CLOUD API (META)
# ==============================================================================
# Obtain from Meta for Developers > WhatsApp > API Setup:
# https://developers.facebook.com/apps/
WHATSAPP_API_KEY=
WHATSAPP_PHONE_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_URL=https://graph.facebook.com/v21.0

# ==============================================================================
# UPSTREAM TELECOM PROVIDER CREDENTIALS: SMS GATEWAY (TRAI / DLT COMPLIANT)
# ==============================================================================
# Provider selection: 'msg91' | 'twilio' | 'generic_http'
SMS_PROVIDER=msg91

# MSG91 Credentials (India Primary)
# DLT Header/Sender ID registered on Jio/Airtel/Vil DLT portal (6 alpha characters)
MSG_GATEWAY_API_KEY=
SMS_PROVIDER_KEY=
SMS_SENDER_ID=VAYENT
SMS_DLT_PE_ID=1701159123456789012
SMS_DLT_TEMPLATE_ID=1407161234567890123
SMS_GATEWAY_URL=https://control.msg91.com/api/v5/flow/

# Twilio Credentials (International / Fallback SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ==============================================================================
# STAGING & CI MOCK SWITCH
# ==============================================================================
# When false (default), real upstream HTTP requests are dispatched to telecom APIs.
# When true, verifies payload formatting and simulates gateway loopback with authentic IDs.
TELECOM_GATEWAY_MOCK=false
